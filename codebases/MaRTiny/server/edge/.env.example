# Copy to ".env" next to server.js. ".env" is ignored by git: your database address is never committed.
MONGO_URL=
MONGO_DB=martiny-studio
EDGE_PORT=8081
# Let a web page on this address read the API. Empty = no CORS headers.
CORS_ORIGIN=
# Where "/" sends visitors (your viewer). Empty = a plain text page.
VIEW_URL=
