# Copy this file to ".env" (next to server.py) and edit it. ".env" is ignored by git, so your database address,
# keys and settings are never committed.

# --- database -------------------------------------------------------------------------------------------
# MongoDB connection string. Leave it empty to keep data in memory only (development; lost on restart).
MONGO_URL=
MONGO_DB=martiny-studio

# --- server ---------------------------------------------------------------------------------------------
SERVER_PORT=8080
# Allow a web page on this address to read the API. Empty = no CORS headers.
CORS_ORIGIN=
# Optional error reporting (Sentry). Empty = off.
SENTRY_DSN=

# --- people detection -----------------------------------------------------------------------------------
# yolo         Ultralytics YOLOv8 (AGPL-3.0, see models/README.md)
# torchvision  Faster R-CNN from torchvision (permissive alternative)
# none         no detection (the server still runs, for testing)
MARTINY_DETECTOR=yolo
YOLO_WEIGHTS=yolov8x.pt
MARTINY_DEVICE=cpu
MARTINY_CONFIDENCE=0.3

# --- shadow detection -----------------------------------------------------------------------------------
# module:function that returns the trained shadow network (see models/README.md). "none" = no shadow detection.
MARTINY_SHADOW_NETWORK=none
# Reuse a device's shadow map for this many seconds (0 = recompute for every photo).
SHADOW_UPDATE_INTERVAL_S=60
# Share of a person's box that must be in shadow to count as "in shade".
SHADE_OVERLAP_FRACTION=0.2

# --- privacy --------------------------------------------------------------------------------------------
# Keep the photographs and shadow maps in the database? They show people. Off unless you turn it on.
STORE_IMAGES=false
MAX_UPLOAD_MB=10
